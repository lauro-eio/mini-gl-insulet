{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egregor.io/schemas/gl-unit-manifest.json",
  "title": "GLUnitManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "unit_id",
    "audience_id",
    "locale",
    "public_title",
    "assets",
    "banned_phrases",
    "word_budgets"
  ],
  "properties": {
    "program_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}$",
      "description": "Internal workshop code (e.g. ATC)."
    },
    "unit_id": {
      "type": "string",
      "pattern": "^u[0-9]{2}$"
    },
    "audience_id": {
      "type": "string",
      "enum": [
        "tier_1_operator",
        "tier_2_frontline_leader",
        "tier_3_operational_manager",
        "tier_4_strategic_leader",
        "shared"
      ]
    },
    "locale": {
      "type": "string",
      "enum": ["en", "es"]
    },
    "public_title": { "type": "string", "minLength": 1 },
    "unit_goal": { "type": "string" },
    "assets": {
      "type": "object",
      "required": [
        "research_article",
        "opinion_article",
        "key_notes",
        "self_assessment",
        "framework_tool",
        "commitment_plan"
      ],
      "properties": {
        "research_article": { "$ref": "#/$defs/assetRef" },
        "opinion_article": { "$ref": "#/$defs/assetRef" },
        "key_notes": { "$ref": "#/$defs/assetRef" },
        "self_assessment": { "$ref": "#/$defs/assetRef" },
        "framework_tool": { "$ref": "#/$defs/assetRef" },
        "commitment_plan": { "$ref": "#/$defs/assetRef" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetRef" }
        },
        "live_roleplay_1v1": { "$ref": "#/$defs/assetRef" },
        "live_roleplay_strategic": { "$ref": "#/$defs/assetRef" }
      },
      "additionalProperties": false
    },
    "banned_phrases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "word_budgets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["max"],
        "properties": {
          "max": { "type": "integer", "minimum": 50 },
          "soft_max": { "type": "integer", "minimum": 50 }
        }
      }
    }
  },
  "$defs": {
    "assetRef": {
      "type": "object",
      "required": ["path", "asset_id"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string" },
        "path": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  }
}
